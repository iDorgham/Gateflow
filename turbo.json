{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": [
    "ADMIN_ACCESS_KEY",
    "ENCRYPTION_MASTER_KEY",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "OPTIMIZE_API_KEY",
    "QR_SIGNING_SECRET",
    "SMTP_FROM",
    "SMTP_HOST",
    "SMTP_PASS",
    "SMTP_PORT",
    "SMTP_USER",
    "STRIPE_PRICE_ID_ENTERPRISE",
    "STRIPE_PRICE_ID_PRO",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "STATSIG_SERVER_API_KEY",
        "EXPERIMENTATION_CONFIG_ITEM_KEY",
        "tune_EXPERIMENTATION_CONFIG_ITEM_KEY",
        "PRISMA_CLIENT_ENGINE_TYPE"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
