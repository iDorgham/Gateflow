{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gateflow.site/schemas/workflow-v2-state.schema.json",
  "title": "GateFlow Workflow v2 state",
  "type": "object",
  "required": [
    "version",
    "sequence",
    "focusedApp",
    "apps",
    "integratedPilot",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "version": { "const": 2 },
    "sequence": {
      "const": ["client-dashboard", "resident-portal", "scanner-app"]
    },
    "focusedApp": {
      "type": ["string", "null"],
      "enum": ["client-dashboard", "resident-portal", "scanner-app", null]
    },
    "apps": {
      "type": "object",
      "required": ["client-dashboard", "resident-portal", "scanner-app"],
      "additionalProperties": false,
      "properties": {
        "client-dashboard": { "$ref": "#/$defs/app" },
        "resident-portal": { "$ref": "#/$defs/app" },
        "scanner-app": { "$ref": "#/$defs/app" }
      }
    },
    "integratedPilot": { "type": "object" },
    "workdirLock": { "type": ["object", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "app": {
      "type": "object",
      "required": ["stage", "evidence", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "parked",
            "focused",
            "audited",
            "planned",
            "developing",
            "checking",
            "pilot-ready",
            "certified"
          ]
        },
        "currentPlan": { "type": ["string", "null"] },
        "baseline": { "type": ["object", "null"] },
        "evidence": { "type": "array" },
        "externalGates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "summary"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": {
                "enum": ["pending", "blocked", "passed", "closed", "complete"]
              },
              "summary": { "type": "string", "minLength": 1 },
              "owner": { "type": "string" },
              "artifact": { "type": "string" },
              "lastCheckedAt": { "type": "string", "format": "date-time" },
              "affectedCredentialNames": {
                "type": "array",
                "items": { "type": "string" }
              },
              "environments": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "certificationReceipt": { "type": ["object", "null"] },
        "pageScoresFile": {
          "type": ["string", "null"],
          "description": "Repo-relative path to a page-score JSON report"
        },
        "pilotFlowCoverage": {
          "description": "Pilot journey coverage array or {covered,total} summary",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "covered": { "type": "number" },
                "total": { "type": "number" },
                "status": { "type": "string" }
              },
              "additionalProperties": true
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "status": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          ]
        },
        "selection": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": ["string", "null"] },
            "agent": { "type": ["string", "null"] },
            "skills": {
              "type": "array",
              "items": { "type": "string" }
            },
            "cli": { "type": ["string", "null"] }
          }
        },
        "delivery": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "branch": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"] },
            "upstream": { "type": ["string", "null"] },
            "pr": { "type": ["number", "string", "null"] },
            "previewSha": { "type": ["string", "null"] }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
