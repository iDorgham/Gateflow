#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Skip if this is an auto-amend from phase-close (RALPH_AMEND env var set)
if [ "$RALPH_AMEND" = "1" ]; then
  exit 0
fi

# 1. Auto-sync AI tools after every commit
bash scripts/ai-sync/sync-ai-tools.sh

# 2. Auto-update CHANGELOG from conventional commit message
#    Only runs for feat/fix/perf/security commits (skips chore/docs/ci)
COMMIT_MSG=$(git log -1 --pretty=%s)
case "$COMMIT_MSG" in
  feat\(*|fix\(*|perf\(*|security\(\)
    node scripts/docs/ralph-docs.js changelog from-commit
    ;;
esac

# 3. Phase auto-close — mark PLAN phases [x] from commit message
node scripts/plan/phase-close.js
