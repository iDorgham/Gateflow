#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# 1. Branch name enforcer
BRANCH=$(git rev-parse --abbrev-ref HEAD)
VALID_PATTERN='^(feat|fix|chore|hotfix|refactor|docs|test|perf|ci|security)(\/.+)?$'

case "$BRANCH" in
  main|master|develop|staging)
    # Protected branches — always allowed to push (via PR workflow)
    ;;
  HEAD)
    # Detached HEAD — skip
    ;;
  *)
    if ! echo "$BRANCH" | grep -qE "$VALID_PATTERN"; then
      echo ""
      echo "❌ Branch name \"$BRANCH\" does not follow the naming convention."
      echo "   Required format: <type>/<description>"
      echo "   Valid types: feat, fix, chore, hotfix, refactor, docs, test, perf, ci, security"
      echo "   Examples:"
      echo "     feat/projects-crm-ui"
      echo "     fix/qr-validation-timeout"
      echo "     chore/update-dependencies"
      echo ""
      echo "   Rename with: git branch -m $BRANCH <new-name>"
      echo "   To bypass:   git push --no-verify"
      echo ""
      exit 1
    fi
    ;;
esac

# 2. Dependency security audit: blocks on HIGH/CRITICAL vulnerabilities
echo "🛡️  Checking dependency security..."
pnpm check:security:fail
SEC_EXIT=$?
if [ $SEC_EXIT -ne 0 ]; then
  exit $SEC_EXIT
fi

# 3. Preflight: lint + typecheck + test
echo "🔍 Running preflight checks before push..."
pnpm preflight
