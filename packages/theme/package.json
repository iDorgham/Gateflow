{
  "name": "@gateflow/theme",
  "version": "0.1.0",
  "license": "MIT",
  "author": "GateFlow Team",
  "description": "Next.js-friendly theme providers and hooks for GateFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/iDorgham/Gateflow.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/cookie.test.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react,react-dom,next-themes"
  },
  "dependencies": {
    "@gateflow/tokens": "workspace:*",
    "next-themes": "^0.4.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@gate-access/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "tsup": "^8.3.6",
    "tsx": "^4.23.11"
  }
}
