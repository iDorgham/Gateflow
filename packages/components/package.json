{
  "name": "@gateflow/components",
  "version": "0.1.0",
  "license": "MIT",
  "author": "GateFlow Team",
  "description": "High-level product layouts and composed patterns for GateFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/iDorgham/Gateflow.git",
    "directory": "packages/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./compositions/*": "./dist/compositions/*.js"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup src/index.ts src/compositions --format cjs,esm --dts --clean --external react,react-dom,@gateflow/tokens,@gateflow/theme,@gateflow/ui,lucide-react,next,framer-motion"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "framer-motion": ">=10.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "framer-motion": "^12.42.2",
    "@gateflow/tokens": "workspace:*",
    "@gateflow/theme": "workspace:*",
    "@gateflow/ui": "workspace:*"
  },
  "devDependencies": {
    "@gate-access/config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "tsup": "^8.3.6"
  }
}
