{
  "name": "@gate-access/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./src/prisma.ts",
    "./client": "./src/client.ts",
    "./quota": "./src/quota.ts",
    "./access": "./src/access.ts"
  },
  "scripts": {
    "test": "bun test --preload ./src/setup.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:studio": "prisma studio",
    "seed:compounds": "npx tsx prisma/seed-compounds.ts",
    "verify:seed-contract": "npx tsx scripts/verify-seed-contract.ts",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "db:generate:edge": "prisma generate --no-engine"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "@gate-access/types": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "ai": "6.0.142",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "nanoid": "^5.1.7",
    "pg": "^8.20.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@gate-access/config": "workspace:*",
    "@types/faker": "^5.5.3",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.18.0",
    "faker": "^5.5.3",
    "prisma": "^5.22.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed-entry.ts",
    "schema": "prisma/schema.prisma"
  }
}
