model WorkOrder {
  id             String                @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         MaintenanceStatus     @default(OPEN)
  priority       MaintenancePriority   @default(MEDIUM)
  category       MaintenanceCategory   @default(GENERAL)
  locationType   MaintenanceLocationType
  locationId     String?
  reporterId     String
  assigneeId     String?
  dueDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter       User                  @relation("ReportedWorkOrders", fields: [reporterId], references: [id])
  assignee       User?                 @relation("AssignedWorkOrders", fields: [assigneeId], references: [id])
  
  // Specific asset relations (optional but indexed and FK-checked)
  gate           Gate?                 @relation(fields: [gateId], references: [id])
  gateId         String?
  unit           Unit?                 @relation(fields: [unitId], references: [id])
  unitId         String?
  project        Project?              @relation(fields: [projectId], references: [id])
  projectId      String?
  vendor         Vendor?               @relation(fields: [vendorId], references: [id])
  vendorId       String?

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([gateId])
  @@index([unitId])
  @@index([projectId])
  @@index([vendorId])
  @@index([deletedAt])
}

