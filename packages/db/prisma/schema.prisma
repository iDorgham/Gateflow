model OrganizationCommunicationConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  provider         String       @default("WHATSAPP") // e.g., WHATSAPP, SMS
  apiKey           String?
  providerSettings Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CommunicationLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  contactId      String?
  provider       String
  type           String       // e.g., INVITATION, ALERT
  status         String       @default("PENDING") // e.g., PENDING, SENT, FAILED, DELIVERED
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([contactId])
  @@index([createdAt])
}

model WorkOrder {
  id             String                @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         MaintenanceStatus     @default(OPEN)
  priority       MaintenancePriority   @default(MEDIUM)
  category       MaintenanceCategory   @default(GENERAL)
  locationType   MaintenanceLocationType
  locationId     String?
  reporterId     String
  assigneeId     String?
  dueDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter       User                  @relation("ReportedWorkOrders", fields: [reporterId], references: [id])
  assignee       User?                 @relation("AssignedWorkOrders", fields: [assigneeId], references: [id])
  
  // Specific asset relations (optional but indexed and FK-checked)
  gate           Gate?                 @relation(fields: [gateId], references: [id])
  gateId         String?
  unit           Unit?                 @relation(fields: [unitId], references: [id])
  unitId         String?
  project        Project?              @relation(fields: [projectId], references: [id])
  projectId      String?
  vendor         Vendor?               @relation(fields: [vendorId], references: [id])
  vendorId       String?

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([gateId])
  @@index([unitId])
  @@index([projectId])
  @@index([vendorId])
  @@index([deletedAt])
}

model Merchant {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([isActive])
}

model Service {
  id             String       @id @default(cuid())
  organizationId String
  merchantId     String
  name           String
  description    String?
  category       String?
  priceCents     Int
  currency       String       @default("USD")
  durationMins   Int?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  merchant     Merchant     @relation(fields: [merchantId], references: [id])

  serviceBookings ServiceBooking[]

  @@index([organizationId])
  @@index([merchantId])
  @@index([deletedAt])
  @@index([isActive])
}

model ServiceBooking {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String
  unitId         String
  userId         String

  status         ServiceBookingStatus @default(PAID)
  priceCents     Int
  currency       String

  // Soft delete for accidental cancel/refund flows
  deletedAt      DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service     @relation(fields: [serviceId], references: [id])
  unit         Unit        @relation(fields: [unitId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([serviceId])
  @@index([unitId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_PARTS
  RESOLVED
  CANCELLED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  HARDWARE
  GENERAL
  FACILITY
}

enum MaintenanceLocationType {
  GATE
  UNIT
  PROJECT
}
