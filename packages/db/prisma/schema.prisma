  aiGeneratedAssets AiGeneratedAsset[]

  @@index([organizationId])
  @@index([userId])
}

model AiAutomation {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  name           String
  description    String?
  type           AiAutomationType
  trigger        String
  schedule       String
  action         Json
