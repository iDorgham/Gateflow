{
  "name": "@gateflow/ui",
  "version": "0.1.0",
  "license": "MIT",
  "author": "GateFlow Team",
  "description": "Premium design primitives for GateFlow based on ADS and Radix UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/iDorgham/Gateflow.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./globals.css": "./src/globals.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./components/*": "./dist/components/*.js"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup && node -e \"const fs=require('fs');['dist/index.js','dist/index.mjs'].forEach(f=>{const c=fs.readFileSync(f,'utf8');if(!c.startsWith('\\\"use client\\\";'))fs.writeFileSync(f,'\\\"use client\\\";\\n'+c);})\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "framer-motion": ">=10.0.0",
    "lucide-react": ">=0.300.0"
  },
  "dependencies": {
    "@atlaskit/tokens": "^11.1.1",
    "@gateflow/tokens": "workspace:*",
    "@gateflow/theme": "workspace:*",
    "@gate-access/types": "workspace:*",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-virtual": "^3.13.23",
    "ai": "5.0.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.40.0",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@gate-access/config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "tsup": "^8.3.6"
  }
}
