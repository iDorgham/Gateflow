{
  "name": "@gateflow/ai",
  "version": "0.1.0",
  "license": "MIT",
  "author": "GateFlow Team",
  "description": "Agentic AI components and patterns for GateFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/iDorgham/Gateflow.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components/*": "./dist/components/*.js"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup src/index.ts src/components --format cjs,esm --dts --clean --external react,react-dom,ai,@ai-sdk/react"
  },
  "peerDependencies": {
    "@ai-sdk/react": ">=2.0.0",
    "ai": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@gateflow/theme": "workspace:*",
    "@gateflow/tokens": "workspace:*",
    "@gateflow/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@gate-access/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "ai": "^6.0.246",
    "@ai-sdk/react": "^3.0.248",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3"
  }
}
