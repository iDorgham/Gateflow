{
  "name": "gate-access",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "preflight": "turbo lint && turbo typecheck && turbo test",
    "db:generate": "pnpm --filter @gate-access/db db:generate",
    "db:studio": "pnpm --filter @gate-access/db db:studio",
    "dev:client": "turbo dev --filter=client-dashboard",
    "dev:admin": "turbo dev --filter=admin-dashboard",
    "dev:scanner": "turbo dev --filter=scanner-app",
    "dev:marketing": "turbo dev --filter=marketing",
    "sync": "bash scripts/sync-ai-tools.sh",
    "sync:watch": "node scripts/watch-sync.mjs",
    "plan:new": "node scripts/ralph-plan.js new",
    "plan:ready": "node scripts/ralph-plan.js ready",
    "plan:start": "node scripts/ralph-plan.js start",
    "plan:done": "node scripts/ralph-plan.js done",
    "plan:status": "node scripts/ralph-plan.js status",
    "plan:run": "node scripts/ralph-run.js",
    "version:bump": "node scripts/ralph-version.js bump",
    "version:tag": "node scripts/ralph-version.js tag",
    "version:info": "node scripts/ralph-version.js info",
    "docs:release": "node scripts/ralph-docs.js release",
    "docs:changelog": "node scripts/ralph-docs.js changelog",
    "docs:readme": "node scripts/ralph-docs.js readme refresh",
    "docs:organize": "node scripts/ralph-organize.js",
    "docs:index": "node scripts/ralph-organize.js index",
    "docs:clean": "node scripts/ralph-organize.js clean"
  },
  "devDependencies": {
    "@gate-access/config": "workspace:*",
    "@turbo/gen": "^1.13.4",
    "@types/faker": "5.5.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "faker": "5.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.7.0",
    "turbo": "^2.8.13",
    "typescript": "5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": "^20.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["linux", "darwin"],
      "cpu": ["x64", "arm64"]
    },
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "prisma"
    ],
    "patchedDependencies": {
      "expo-router@6.0.23": "patches/expo-router@6.0.23.patch"
    }
  }
}
