{
  "name": "gate-access",
  "version": "0.3.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm turbo build",
    "dev": "pnpm turbo dev",
    "lint": "pnpm turbo lint",
    "test": "pnpm turbo test",
    "typecheck": "pnpm turbo typecheck",
    "typecheck:all": "pnpm turbo typecheck",
    "preflight": "pnpm docs:changelog:check && pnpm check:ads && pnpm check:bootstrap-routes && pnpm turbo lint && pnpm turbo typecheck && pnpm turbo test",
    "test:check-scripts": "node --test scripts/check/__tests__/*.test.js",
    "check:test-budgets": "node scripts/check/check-test-budgets.js",
    "check:secrets:history": "node scripts/check/scan-secrets.js --history 100",
    "check:ads": "node scripts/check/enforce-ads-design.js packages/ui packages/components",
    "db:generate": "pnpm --filter @gate-access/db db:generate",
    "db:studio": "pnpm --filter @gate-access/db db:studio",
    "dev:client": "pnpm turbo dev --filter=client-dashboard",
    "dev:admin": "pnpm turbo dev --filter=admin-dashboard",
    "dev:scanner": "pnpm turbo dev --filter=scanner-app",
    "dev:marketing": "pnpm turbo dev --filter=marketing",
    "dev:resident": "pnpm turbo dev --filter=resident-portal",
    "dev:mobile": "pnpm turbo dev --filter=resident-mobile",
    "dev:design": "pnpm turbo dev --filter=@gateflow/design-system",
    "build:design": "pnpm turbo build --filter=@gateflow/design-system",
    "sync": "bash scripts/ai-sync/sync-ai-tools.sh",
    "sync:watch": "node scripts/ai-sync/watch-sync.mjs",
    "workflow:v2": "node scripts/workflow-v2/cli.js",
    "workflow:v2:guide": "node scripts/workflow-v2/guide-cli.js",
    "workflow:v2:check": "node --test scripts/workflow-v2/__tests__/*.test.js",
    "workflow:v2:routes": "node scripts/workflow-v2/support-cli.js routes",
    "workflow:v2:verify": "node scripts/workflow-v2/operations-cli.js verify",
    "workflow:v2:loop": "node scripts/workflow-v2/loop-cli.js",
    "workflow:v2:delivery": "node scripts/workflow-v2/delivery-cli.js",
    "dev:loop": "node scripts/workflow-v2/loop-cli.js",
    "pilot:loop": "node scripts/workflow-v2/loop-cli.js --profile pilot",
    "plan:new": "node scripts/plan/ralph-plan.js new",
    "plan:ready": "node scripts/plan/ralph-plan.js ready",
    "plan:start": "node scripts/plan/ralph-plan.js start",
    "plan:done": "node scripts/plan/ralph-plan.js done",
    "plan:status": "node scripts/plan/ralph-plan.js status",
    "plan:run": "node scripts/plan/ralph-run.js",
    "version:bump": "node scripts/version/ralph-version.js bump",
    "version:tag": "node scripts/version/ralph-version.js tag",
    "version:info": "node scripts/version/ralph-version.js info",
    "docs:release": "node scripts/docs/ralph-docs.js release",
    "docs:changelog": "node scripts/docs/ralph-docs.js changelog",
    "docs:changelog:check": "node scripts/check/check-changelog.js",
    "docs:changelog:format": "node scripts/docs/format-changelog.js",
    "docs:readme": "node scripts/docs/ralph-docs.js readme refresh",
    "docs:organize": "node scripts/docs/ralph-organize.js",
    "docs:index": "node scripts/docs/ralph-organize.js index",
    "docs:clean": "node scripts/docs/ralph-organize.js clean",
    "plan:pr": "node scripts/plan/ralph-plan.js pr",
    "check:env": "node scripts/check/check-env.js",
    "check:env:client": "node scripts/check/check-env.js --app client",
    "check:secrets": "node scripts/check/scan-secrets.js --all",
    "check:bundle": "node scripts/check/check-bundle-size.js",
    "check:bundle:update": "node scripts/check/check-bundle-size.js --update",
    "check:bundle:report": "node scripts/check/check-bundle-size.js --report",
    "check:imports": "node scripts/check/check-imports.js",
    "check:imports:fail": "node scripts/check/check-imports.js --fail --summary",
    "check:todos": "node scripts/check/todos.js",
    "check:todos:fixme": "node scripts/check/todos.js --type FIXME",
    "check:todos:old": "node scripts/check/todos.js --old 30",
    "check:db-drift": "node scripts/check/check-db-drift.js",
    "check:db-drift:schema": "node scripts/check/check-db-drift.js --schema",
    "check:bootstrap-routes": "node scripts/check/check-bootstrap-routes.js",
    "check:security": "node scripts/check/check-security.js",
    "check:security:fail": "node scripts/check/check-security.js --fail",
    "check:security:fix": "node scripts/dev/security-fix.js",
    "docs:release:dry": "node scripts/docs/ralph-docs.js release --dry-run",
    "hotfix:start": "node scripts/ralph/ralph-hotfix.js start",
    "hotfix:done": "node scripts/ralph/ralph-hotfix.js done",
    "hotfix:status": "node scripts/ralph/ralph-hotfix.js status",
    "check:pre-deploy": "node scripts/dev/pre-deploy.js",
    "check:pre-deploy:fail": "node scripts/dev/pre-deploy.js --fail",
    "setup:dev": "node scripts/dev/setup-dev.js",
    "ralph": "node scripts/ralph/ralph.js",
    "ralph:short": "node scripts/ralph/ralph.js --short"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@gate-access/config": "workspace:*",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@turbo/gen": "^1.13.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "ai": "6.0.246",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.5",
    "globals": "^16.4.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.0",
    "turbo": "^2.10.7",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "prisma"
    ],
    "patchedDependencies": {
      "expo-router@6.0.23": "patches/expo-router@6.0.23.patch",
      "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch",
      "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch",
      "expo-modules-core@57.0.10": "patches/expo-modules-core@57.0.10.patch"
    },
    "overrides": {
      "eslint": "9.39.5",
      "typescript": "5.9.3",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "handlebars": ">=4.7.9",
      "path-to-regexp": ">=0.1.13",
      "minimatch": ">=10.2.4",
      "braces": ">=3.0.3",
      "brace-expansion": ">=5.0.9",
      "js-yaml@^3.0.0": "3.15.1",
      "js-yaml@^4.0.0": "4.3.1",
      "nanoid@^3.0.0": "3.3.18",
      "nanoid@^5.0.0": "5.1.16",
      "tar": ">=7.5.21",
      "glob": ">=10.5.0",
      "jsondiffpatch": ">=0.7.2",
      "tmp": ">=0.2.7 <1.0.0",
      "zod": "4.4.3",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@xmldom/xmldom": ">=0.9.10 <1.0.0",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "next": "^16.3.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "basic-ftp": ">=5.3.0 <6.0.0",
      "fast-uri": ">=3.1.5 <4.0.0",
      "linkify-it": ">=5.0.1 <6.0.0",
      "shell-quote": ">=1.8.4 <2.0.0",
      "undici": ">=6.27.0 <7.0.0",
      "ws": ">=8.21.0 <9.0.0",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1",
      "ip-address": ">=10.4.0",
      "markdown-it": ">=14.2.0",
      "@babel/core": "^7.29.6",
      "esbuild": ">=0.28.1",
      "@ai-sdk/provider-utils": "4.0.42",
      "react-native-reanimated": "4.5.3",
      "react-native-worklets": "0.11.3",
      "react-native-screens": "4.26.2"
    }
  },
  "dependencies": {
    "@gate-access/db": "workspace:^0.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.0.18"
  }
}
