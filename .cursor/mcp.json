{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "pencil": {
      "transport": "stdio",
      "command": "/Users/Dorgham/.antigravity/extensions/highagency.pencildev-0.6.32-universal/out/mcp-server-darwin-x64",
      "args": [
        "--app",
        "antigravity"
      ],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "browser": {
