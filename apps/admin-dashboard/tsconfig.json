{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gate-access/utils": ["../../packages/utils/src/index.ts"],
      "@gate-access/utils/*": ["../../packages/utils/src/*"],
      "react": ["../../node_modules/@types/react"],
      "react/jsx-runtime": ["../../node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": [
        "../../node_modules/@types/react/jsx-dev-runtime"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "tests"]
}
