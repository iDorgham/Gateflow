{
  "name": "scanner-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start --go --lan -c",
    "dev:sim": "EXPO_NO_TELEMETRY=1 expo start --go --localhost --ios -c",
    "build": "mkdir -p .metro && TMPDIR=$PWD/.metro EXPO_NO_TELEMETRY=1 CI=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 expo export --no-bytecode",
    "lint": "EXPO_NO_TELEMETRY=1 CI=1 expo lint",
    "test": "jest --forceExit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@gate-access/types": "^0.1.0",
    "@gateflow/ui": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "ai": "5.0.52",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.11",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-modules-core": "~57.0.10",
    "expo-image-picker": "~57.0.8",
    "expo-jwt": "^1.8.2",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.8",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "lucide-react-native": "^0.575.0",
    "react": "19.2.8",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "description": "Expo / React Native mobile scanner app for QR code scanning.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
