{
  "expo": {
    "name": "scanner-app",
    "slug": "scanner-app",
    "version": "0.1.0",
    "description": "Expo / React Native mobile scanner app for QR code scanning.",
    "platforms": ["ios", "android"],
    "android": {
      "package": "com.gateflow.scanner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.gateflow.scanner"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "GateFlow needs camera access to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GateFlow uses your location to record where scans occur."
        }
      ],
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "763a415b-d5c4-4eff-a74b-9d6fc76b3e3e"
      }
    }
  }
}
